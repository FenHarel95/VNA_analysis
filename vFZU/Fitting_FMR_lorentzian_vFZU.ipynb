  {
   "cell_type": "code",
   "execution_count": 126,
   "id": "9842e15c-0d83-4735-a2ea-38e584499303",
   "metadata": {},
   "outputs": [],
   "source": [
    "gamma = 28.8   # GHz/T\n",
    "Hx = 0.145     # T\n",
    "Hy = 0.0       # T\n",
    "\n",
    "# --- raw fitted data ---\n",
    "H_raw  = data_L_fits['field']\n",
    "f_raw  = data_L_fits['fo']\n",
    "df_raw = data_L_fits['df']\n",
    "\n",
    "# --- remove bad low-field fits ---\n",
    "H  = H_raw[:-8]\n",
    "f  = f_raw[:-8]\n",
    "\n",
    "\n",
    "# --- linewidth conversion (Kittel-derived expression) ---\n",
