    "from scipy.stats import linregress\n",
    "# Linear fit of dH vs frequency\n",
    "fit = linregress(f, dH)\n",
    "\n",
    "slope = fit.slope\n",
    "intercept = fit.intercept\n",
    "r2 = fit.rvalue**2\n",
    "\n",
    "# Gilbert damping\n",
    "alpha = slope * gamma / 2\n",
    "\n",
    "print(f\"Slope = {slope:.6e} T/GHz\")\n",
    "print(f\"ΔH0 = {intercept:.6e} T\")\n",
    "print(f\"R² = {r2:.6f}\")\n",
    "print(f\"α = {alpha:.6e}\")"
   ]
